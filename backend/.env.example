# backend/.env.example
# Скопировать в backend/.env (локально) или задать в панели RelaxDev (прод).
# Файл .env в git не попадает — см. .gitignore.

# ============================================================
# ОБЯЗАТЕЛЬНЫЕ — без них сервер не стартует
# ============================================================

# Ключ подписи JWT. Минимум 32 символа.
# Сгенерировать: openssl rand -base64 48
# ⚠️ При смене все выданные токены становятся недействительными —
#    пользователям придётся войти заново. Это нормально.
JWT_SECRET=

# Строка подключения к PostgreSQL на RelaxDev
DATABASE_URL=postgresql://user:password@host:5432/database

# ============================================================
# НЕОБЯЗАТЕЛЬНЫЕ — есть разумные значения по умолчанию
# ============================================================

PORT=8080
NODE_ENV=production

# Срок жизни токена входа (по умолчанию 24h)
JWT_EXPIRES_IN=24h

# Сколько обратных прокси стоит перед приложением.
# На RelaxDev обычно 1. Значение true небезопасно: позволяет
# подделать IP через X-Forwarded-For и обойти rate limiting.
TRUST_PROXY_HOPS=1

# Стоимость bcrypt (по умолчанию 12)
BCRYPT_ROUNDS=12
